# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/chat_app

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGINS=http://localhost:3005

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# lax works when web and API share a site (localhost, or app.example.com + api.example.com).
# Use none (+ HTTPS) only if they are on different sites.
COOKIE_SAMESITE=lax

# Number of proxies in front of the API (1 on Vercel or behind Nginx). 0 locally.
TRUST_PROXY=0
LOG_LEVEL=info

# ---- Email (verification + password reset codes) ----
# Link used in emails (your frontend URL)
APP_URL=http://localhost:3005
# Leave SMTP_HOST empty in development: emails are printed in the server console.
# Any SMTP works: Gmail (app password), Mailtrap, Resend, Brevo, SES...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Relay <no-reply@yourdomain.com>"

# ---- Real-time updates (Ably) ----
# Ably dashboard → your app → API Keys → copy the root key ("appId.keyId:secret").
# Empty in development: the app works, but nothing is pushed live.
ABLY_API_KEY=
